    },
    {
      "id": "TnPaFjlHOx37MIIzjRNPe",
      "type": "text",
      "x": 2217.0246986306174,
      "y": 570.060815525309,
      "width": 932.9985961914062,
      "height": 432,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aK",
      "roundness": null,
      "seed": 566367885,
      "version": 1867,
      "versionNonce": 550581923,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786116639360,
      "link": null,
      "locked": false,
      "text": "A Task represents a piece of work or an activity that a user can complete for a Contributor Organization \nin exchange for Credits.\nA Task is created by a Contributor Organization\nThe Task describes what work needs to be completed\nA Task can define requirements such as:\n- Description\n- Location\n- Start/end time\n- Number of participants\n- Credit reward\n- Completion requirements\nA user can accept or join the Task\nOnce completed, the Task must be verified\nEcho manages or assists with the verification process\nAfter successful verification, the user is awarded the configured number of Credits\nA Task should only generate Credits when legitimate work has actually been completed",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A Task represents a piece of work or an activity that a user can complete for a Contributor Organization \nin exchange for Credits.\nA Task is created by a Contributor Organization\nThe Task describes what work needs to be completed\nA Task can define requirements such as:\n- Description\n- Location\n- Start/end time\n- Number of participants\n- Credit reward\n- Completion requirements\nA user can accept or join the Task\nOnce completed, the Task must be verified\nEcho manages or assists with the verification process\nAfter successful verification, the user is awarded the configured number of Credits\nA Task should only generate Credits when legitimate work has actually been completed",
      "autoResize": true,
      "lineHeight": 1.35
    },
