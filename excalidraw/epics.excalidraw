    {
      "id": "AqEUoSIBGZRcJjjxATTTe",
      "type": "text",
      "x": 3212.625644516369,
      "y": 569.8132211022676,
      "width": 892.2987060546875,
      "height": 432,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aN",
      "roundness": null,
      "seed": 388989613,
      "version": 2308,
      "versionNonce": 1740088333,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786116645461,
      "link": null,
      "locked": false,
      "text": "An Offer represents a product, service, discount, experience, or other benefit that a user can obtain \nfrom a Partner Organization by spending Credits.\nAn Offer is created by a Partner Organization\nThe Offer describes what the user receives\nAn Offer can define properties such as:\n- Title\n- Description\n- Credit price\n- Availability\n- Expiration date\n- Redemption requirements\n- Usage limitations\nA user can choose to redeem the Offer\nEcho deducts or reserves the required Credits\nThe Partner Organization receives confirmation that the Offer has been redeemed\nThe Partner Organization then provides the associated product, service, or benefit",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An Offer represents a product, service, discount, experience, or other benefit that a user can obtain \nfrom a Partner Organization by spending Credits.\nAn Offer is created by a Partner Organization\nThe Offer describes what the user receives\nAn Offer can define properties such as:\n- Title\n- Description\n- Credit price\n- Availability\n- Expiration date\n- Redemption requirements\n- Usage limitations\nA user can choose to redeem the Offer\nEcho deducts or reserves the required Credits\nThe Partner Organization receives confirmation that the Offer has been redeemed\nThe Partner Organization then provides the associated product, service, or benefit",
      "autoResize": true,
      "lineHeight": 1.35
    },
