    {
      "id": "9ekJDvBkHktKbjVO39fvi",
      "type": "text",
      "x": 1214.126946841282,
      "y": 573.9916025200305,
      "width": 913.0787353515625,
      "height": 486,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aF",
      "roundness": null,
      "seed": 522422339,
      "version": 1405,
      "versionNonce": 1146100195,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786116205179,
      "link": null,
      "locked": false,
      "text": "An Organization is created by a verified administrator and belongs to one of two organization types:\n\n1. Contributor Organization\nExamples: charities, NGOs, volunteer organizations, community organizations.\nA Contributor Organization creates opportunities for users to contribute work in exchange for Credits.\n- The organization creates Tasks\n- A user can accept a Task\n- When the Task is completed and verified, the user receives Credits\n- Credits are issued by the Echo platform on behalf of the organization\n- Echo monitors/verifies Task completion to prevent fraudulent or artificial generation of Credits\n\n2. Partner Organization\nExamples: companies, stores, cafés, entertainment venues, service providers.\nA Partner Organization creates offers that allow users to spend their Credits.\n- The organization creates Offers\n- An Offer defines a product, service, discount, experience, etc.\n- A user can redeem an Offer using Credits\n- The Partner Organization provides the associated product or service",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An Organization is created by a verified administrator and belongs to one of two organization types:\n\n1. Contributor Organization\nExamples: charities, NGOs, volunteer organizations, community organizations.\nA Contributor Organization creates opportunities for users to contribute work in exchange for Credits.\n- The organization creates Tasks\n- A user can accept a Task\n- When the Task is completed and verified, the user receives Credits\n- Credits are issued by the Echo platform on behalf of the organization\n- Echo monitors/verifies Task completion to prevent fraudulent or artificial generation of Credits\n\n2. Partner Organization\nExamples: companies, stores, cafés, entertainment venues, service providers.\nA Partner Organization creates offers that allow users to spend their Credits.\n- The organization creates Offers\n- An Offer defines a product, service, discount, experience, etc.\n- A user can redeem an Offer using Credits\n- The Partner Organization provides the associated product or service",
      "autoResize": true,
      "lineHeight": 1.35
    },
