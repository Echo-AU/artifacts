efault;" value="409 Problem (Outcome.ToResult())"><mxGeometry relative="1" as="geometry"><mxPoint x="2255" y="5679" as="sourcePoint"/><mxPoint x="175" y="5679" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c138" parent="1" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;fillColor=none;width=50;height=19;" value="&lt;b&gt;ext&lt;/b&gt;" vertex="1"><mxGeometry height="174" width="2705" x="120" y="5529" as="geometry"/></mxCell><mxCell id="c139" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=0;strokeColor=none;fillColor=none;fontSize=11;labelBackgroundColor=default;" value="[Reject() fejler: Application er ikke PENDING]" vertex="1"><mxGeometry height="20" width="296" x="124" y="5550" as="geometry"/></mxCell><mxCell id="c140" edge="1" parent="1" style="html=1;verticalAlign=bottom;elbow=vertical;curved=0;rounded=0;endArrow=block;endSize=6;endFill=1;fontSize=11;labelBackgroundColor=default;" value="SaveChangesAsync(ct)"><mxGeometry relative="1" as="geometry"><mxPoint x="2785" y="5729" as="sourcePoint"/><mxPoint x="3295" y="5729" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c141" edge="1" parent="1" style="html=1;verticalAlign=bottom;elbow=vertical;rounded=0;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=default;" value="int // antal ændrede rækker"><mxGeometry relative="1" as="geometry"><mxPoint x="3295" y="5774" as="sourcePoint"/><mxPoint x="2785" y="5774" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c142" edge="1" parent="1" style="html=1;verticalAlign=bottom;elbow=vertical;rounded=0;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=default;" value="ApplicationOutcome.Succeeded"><mxGeometry relative="1" as="geometry"><mxPoint x="2775" y="5819" as="sourcePoint"/><mxPoint x="2525" y="5819" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c143" edge="1" parent="1" style="html=1;verticalAlign=bottom;elbow=vertical;rounded=0;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=default;" value="ApplicationOutcome.Succeeded"><mxGeometry relative="1" as="geometry"><mxPoint x="2515" y="5864" as="sourcePoint"/><mxPoint x="2265" y="5864" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c144" edge="1" parent="1" style="html=1;verticalAlign=bottom;elbow=vertical;rounded=0;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=default;" value="204 NoContent"><mxGeometry relative="1" as="geometry"><mxPoint x="2255" y="5909" as="sourcePoint"/><mxPoint x="175" y="5909" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c182" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=0;strokeColor=none;fillColor=none;" value='&lt;font style="font-size: 32px;"&gt;Sekvensdiagram m. klasser (Server CPU)&lt;/font&gt;' vertex="1"><mxGeometry height="50" width="1200" x="40" y="20" as="geometry"/></mxCell><mxCell id="c183" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=0;strokeColor=none;fillColor=none;" value='&lt;font style="font-size: 16px;"&gt;[PRE]: Systemet er startet, Peer (Poster) er logget ind og har oprettet en OPEN Task, som Peers har ansøgt til&lt;/font&gt;' vertex="1"><mxGeometry height="36" width="1800" x="40" y="78" as="geometry"/></mxCell><mxCell id="c184" parent="1" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=240;height=30;" value="&lt;b&gt;sd US-7b-S:&lt;/b&gt; Accepter PeerTask Application" vertex="1"><mxGeometry height="5849" width="3400" x="60" y="140" as="geometry"/></mxCell><mxCell id="c185" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" value='Bemærk: Koden er den samme for en Organization- og en Peer-Poster: rollepolitikken tillader begge, og tjekket "Task tilhører Poster" (CreatedByUserId) afgør, hvem der må vælge. Kapaciteten tjekkes og Contribution oprettes i én Serializable-transaktion, så to samtidige accepts ikke kan overfylde Tasken. Når Tasken er fuld, forbliver de øvrige ansøgere PENDING, og Posteren afviser dem selv (TODO i TaskApplicationService).' vertex="1"><mxGeometry height="80" width="1200" x="60" y="6009" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>