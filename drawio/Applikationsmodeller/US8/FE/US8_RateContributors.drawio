illColor=none;fontSize=11;labelBackgroundColor=default;" value='status-badge "Udført"; canFinish(), canCancel() og knappen "Annuller" skjules; toast vises' vertex="1"><mxGeometry height="22" width="565" x="374" y="2091" as="geometry"/></mxCell><mxCell id="c65" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=0;strokeColor=none;fillColor=none;" value='&lt;font style="font-size: 32px;"&gt;Sekvensdiagram m. klasser (Client CPU)&lt;/font&gt;' vertex="1"><mxGeometry height="50" width="1200" x="40" y="20" as="geometry"/></mxCell><mxCell id="c66" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=0;strokeColor=none;fillColor=none;" value='&lt;font style="font-size: 16px;"&gt;[PRE]: Systemet er startet, Poster (Organization eller Peer) er logget ind og står på Task details for en IN_PROGRESS Task, hvor Contributors endnu ikke er bedømt&lt;/font&gt;' vertex="1"><mxGeometry height="36" width="1800" x="40" y="78" as="geometry"/></mxCell><mxCell id="c67" parent="1" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=240;height=30;" value="&lt;b&gt;sd US-8-C:&lt;/b&gt; Rate Contributors og afslut Task" vertex="1"><mxGeometry height="2042" width="2160" x="40" y="140" as="geometry"/></mxCell><mxCell id="c68" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" value='Bemærk: Server er en ekstern deltager her (se BE-diagrammerne for betaling og escrow). Der er ingen enkeltstående "Bedøm"-knap: bedømmelse sker kun som en del af "Afslut &amp;amp; overfør", der går gennem alle ubedømte Contributors én ad gangen og til sidst afslutter Tasken. Bedømmelser, der allerede er sendt, kan ikke fortrydes.' vertex="1"><mxGeometry height="70" width="1200" x="40" y="2212" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>