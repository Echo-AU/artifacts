int"/></mxGeometry></mxCell><mxCell id="c123" edge="1" parent="1" style="html=1;verticalAlign=bottom;elbow=vertical;rounded=0;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=default;" value="TaskOutcome.Succeeded"><mxGeometry relative="1" as="geometry"><mxPoint x="1995" y="5084" as="sourcePoint"/><mxPoint x="1745" y="5084" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c124" edge="1" parent="1" style="html=1;verticalAlign=bottom;elbow=vertical;rounded=0;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=default;" value="TaskOutcome.Succeeded"><mxGeometry relative="1" as="geometry"><mxPoint x="1735" y="5129" as="sourcePoint"/><mxPoint x="1485" y="5129" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c125" edge="1" parent="1" style="html=1;verticalAlign=bottom;elbow=vertical;rounded=0;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=default;" value="204 NoContent"><mxGeometry relative="1" as="geometry"><mxPoint x="1475" y="5174" as="sourcePoint"/><mxPoint x="175" y="5174" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c156" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=0;strokeColor=none;fillColor=none;" value='&lt;font style="font-size: 32px;"&gt;Sekvensdiagram m. klasser (Server CPU)&lt;/font&gt;' vertex="1"><mxGeometry height="50" width="1200" x="40" y="20" as="geometry"/></mxCell><mxCell id="c157" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=0;strokeColor=none;fillColor=none;" value='&lt;font style="font-size: 16px;"&gt;[PRE]: Systemet er startet, Poster (Organization eller Peer) er logget ind og står på Task details for en IN_PROGRESS Task, hvor Contributors endnu ikke er bedømt&lt;/font&gt;' vertex="1"><mxGeometry height="36" width="1800" x="40" y="78" as="geometry"/></mxCell><mxCell id="c158" parent="1" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=240;height=30;" value="&lt;b&gt;sd US-8-S:&lt;/b&gt; Rate Contributors og afslut Task" vertex="1"><mxGeometry height="5114" width="3145" x="60" y="140" as="geometry"/></mxCell><mxCell id="c159" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" value="Bemærk: Rating og afslutning er to adskilte handlinger. Rating betaler Contributor (Karma Koins eller fra escrow) og sætter Contribution til COMPLETED, men afslutter ikke Tasken. Først POST /complete sætter Task til COMPLETED og refunderer ubrugt escrow. Betalingen sker, før Rating gemmes (ADR 0004). Peer-ratingens gennemsnit (avg_rating) opdateres endnu ikke (BLOCKED: Users)." vertex="1"><mxGeometry height="80" width="1300" x="60" y="5274" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>