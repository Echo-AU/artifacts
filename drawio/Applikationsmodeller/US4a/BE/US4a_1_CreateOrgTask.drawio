                <mxCell id="n48" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=0;strokeColor=none;fillColor=none;" value="&lt;span style=&quot;font-size: 32px;&quot;&gt;Systemsekvensdiagram u. klasser (v2)&lt;/span&gt;" vertex="1">
                    <mxGeometry height="50" width="1200" x="200" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="n49" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=0;strokeColor=none;fillColor=none;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;[PRE]: &lt;/b&gt;Systemet er startet, Organization er logget ind og har navigeret til &quot;Mine Opgaver&quot;&lt;/font&gt;" vertex="1">
                    <mxGeometry height="36" width="1400" x="200" y="90" as="geometry"/>
                </mxCell>
                <mxCell id="n50" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" value="&lt;b style=&quot;font-size:15px&quot;&gt;User Story&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Som en Organization skal jeg kunne oprette og offentliggøre aktiviteter, så Contributors kan finde og tilmelde sig dem for at bidrage til min organisations formål.&lt;/span&gt;" vertex="1">
                    <mxGeometry height="100" width="560" x="1590" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="n51" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Ændringer ift. din original&lt;/b&gt;&lt;br&gt;• Ikke-Organization giver &lt;b&gt;403&lt;/b&gt; (ikke 401). 401 er kun &quot;ikke logget ind&quot;.&lt;br&gt;• Tilføjet manglende trin: &lt;b&gt;Tjek at kategori findes&lt;/b&gt; (DB) + alt-gren 400 &quot;Kategori findes ikke&quot;.&lt;br&gt;• Validering dækker nu også &lt;b&gt;beskrivelse&lt;/b&gt; og &lt;b&gt;max deltagere&lt;/b&gt; (ikke kun titel/kategori/point).&lt;br&gt;• Svar er &lt;b&gt;201 + Id&lt;/b&gt; med Location-header, ikke hele Task (CreateOrganizationTaskResponse(Id)).&lt;br&gt;• Formular-udfyldning nævner nu også &lt;b&gt;max deltagere&lt;/b&gt;.&lt;br&gt;• Database &quot;returnerer ikke status&quot;: Server sætter DRAFT, DB svarer blot &quot;Gemt&quot;.&lt;br&gt;• Rettet tastefejl i titel (&quot;Systemsekvens&quot;) og frame-guard (&quot;Request body&quot;)." vertex="1">
                    <mxGeometry height="330" width="520" x="1700" y="150" as="geometry"/>
                </mxCell>
                <mxCell id="n2" edge="1" parent="1" source="n42" style="html=1;verticalAlign=bottom;elbow=vertical;curved=0;rounded=0;endArrow=open;endSize=6;endFill=0;fontSize=11;labelBackgroundColor=default;" value="Trykker på &quot;Opret Task&quot;">
