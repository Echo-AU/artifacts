                <mxCell id="text186" value="R10 · sådan fastholdes 0..1 ↔ 0..1" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#172B4D;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="70" y="944" width="695" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="text187" value="application_id må være NULL; udfyldte værdier skal være unikke.&#xa;FK peger på TaskApplication.id. Derudover kræves ACCEPTED-status&#xa;og samme task_id/user_id på ansøgning og deltager.&#xa;Disse tværgående regler skal håndhæves særskilt i implementeringen." style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#172B4D;fontStyle=0;" parent="1" vertex="1">
