                </mxCell>
                <mxCell id="text5021" value="R18" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=13;fontColor=#536781;fontStyle=1;" parent="1" vertex="1">
