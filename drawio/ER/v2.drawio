                </mxCell>
                <mxCell id="text189" value="Afgrænsning" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#172B4D;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="835" y="944" width="695" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="text190" value="Der er ikke tilføjet UNIQUE(task_id, user_id) på deltagere eller&#xa;ansøgninger: dette var ikke et angivet krav. PK er id.&#xa;Enum-navne følger eksemplet; PART_ROLE er angivet på hovedfanen.&#xa;Skemaet er en model, ikke en færdig SQL-migration." style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#172B4D;fontStyle=0;" parent="1" vertex="1">
