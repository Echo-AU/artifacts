                <mxCell id="edge5022" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=none;startArrow=none;strokeColor=#526A88;strokeWidth=1.6;exitX=1;exitY=0.2777777777777778;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" parent="1" source="RewardRedemption" target="R18" edge="1">
