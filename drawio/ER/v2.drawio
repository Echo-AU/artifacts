                </mxCell>
                <mxCell id="text87" value="Roller og deltagelse" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#172B4D;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="1825" width="890" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="text88" value="Requestor og Contributor er roller på TaskParticipant, ikke user-types.&#xa;PART_ROLE = {REQUESTER, CONTRIBUTOR}; REQUESTER er enum-navnet.&#xa;OrganizationTask kræver 1..N Contributors og højst max_participants.&#xa;reward_points er belønning pr. deltager. Generelt har Task 0..N deltagere.&#xa;Contributor på en OrganizationTask skal være en IndividualUser." style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#172B4D;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="80" y="1865" width="890" height="119" as="geometry"/>
                </mxCell>
                <mxCell id="rect89" value="" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;fillColor=#F4F7FC;strokeColor=#C6D3E4;" parent="1" vertex="1">
                    <mxGeometry x="2260" y="1600" width="760" height="216" as="geometry"/>
                </mxCell>
                <mxCell id="text90" value="Fra ansøgning til deltagelse" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#172B4D;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="2280" y="1615" width="720" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="text91" value="TaskParticipant.application_id er valgfri og unik blandt udfyldte værdier.&#xa;Den refererer til TaskApplication.id.&#xa;Kun en ACCEPTED-ansøgning må være grundlag for deltagelse.&#xa;Ansøgning og deltager skal have samme task_id og user_id.&#xa;En deltager kan eksistere uden en ansøgning.&#xa;En ansøgning kan højst føre til én deltager." style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#172B4D;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="2280" y="1655" width="720" height="151" as="geometry"/>
                </mxCell>
                <mxCell id="rect92" value="" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;fillColor=#F4F7FC;strokeColor=#C6D3E4;" parent="1" vertex="1">
                    <mxGeometry x="2260" y="1850" width="760" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="text93" value="Modelvalg" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#172B4D;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="2280" y="1865" width="720" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="text94" value="PK/FK-specialiseringerne vises med grønne relationsromber.&#xa;Der antages ikke total eller disjunkt specialisering af User.&#xa;UUID og øvrige datatyper følger eksemplet og kan tilpasses." style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#172B4D;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="2280" y="1905" width="720" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="rect95" value="" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;fillColor=#F0F4FA;strokeColor=#C6D3E4;" parent="1" vertex="1">
                    <mxGeometry x="60" y="2050" width="2960" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="text96" value="Sådan læses diagrammet" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=21;fontColor=#172B4D;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="2066" width="850" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="text97" value="1 / N angiver maksimum ved modsatte entitet. Enkeltlinje = valgfri deltagelse; dobbeltlinje = obligatorisk.&#xa;Eksempel: User — 1 ◇ opretter ◇ N ═ Task betyder: én user kan have 0..N tasks; hver task har præcis én user." style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#172B4D;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="80" y="2108" width="1410" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="text98" value="PK = primærnøgle · FK = fremmednøgle · UQ = unik blandt udfyldte værdier · ? = nullable&#xa;Se fanen “Relationsoversigt” for de 14 relationer på denne fane samt deres FK-mål." style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#172B4D;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="1580" y="2108" width="1400" height="68" as="geometry"/>
                </mxCell>
