                <mxCell id="edge5023" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=none;startArrow=none;strokeColor=#526A88;strokeWidth=1.6;exitX=0;exitY=0.4098360655737705;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" parent="1" source="LedgerTransaction" target="R18" edge="1">
