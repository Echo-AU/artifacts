                <mxCell id="edge5037" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=none;startArrow=none;strokeColor=#526A88;strokeWidth=1.6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" parent="1" source="LedgerTransaction" target="R24" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="edge5038" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=none;startArrow=none;strokeColor=#526A88;strokeWidth=1.6;exitX=1;exitY=0.802675585284281;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" parent="1" source="LedgerTransaction" target="R24" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1620" y="1690"/>
                            <mxPoint x="1620" y="1910"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="text5039" value="1" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=19;fontColor=#172B4D;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1270" y="1770" width="50" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="text5040" value="original" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#536781;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="1120" y="1781" width="125" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="text5041" value="N" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=19;fontColor=#172B4D;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1480" y="1657" width="50" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="text5042" value="korrektion" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#536781;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="1500" y="1730" width="110" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="rect5043" value="" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;fillColor=#F4F7FC;strokeColor=#C6D3E4;" parent="1" vertex="1">
                    <mxGeometry x="60" y="520" width="805" height="282" as="geometry"/>
                </mxCell>
                <mxCell id="text5044" value="Konti, aktiver og saldo" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#172B4D;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="535" width="765" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="text5045" value="ASSET_KIND = {CURRENCY, KARMA}. Eksempler: DKK, EUR, KARMA.&#xa;Hver konto føres i præcis ét aktiv; fraction_digits er 0..4&#xa;og er 0 for KARMA. Kontoens aktiv ændres ikke efter brug.&#xa;ACCOUNT_KIND = {USER, SYSTEM}. USER kræver owner_user_id.&#xa;SYSTEM-konti har ingen User-ejer og bruges som modkonti.&#xa;Saldo = summen af amount fra POSTED-transaktioner.&#xa;Positivt beløb øger saldoen; negativt beløb reducerer den.&#xa;Konti oprettes efter behov; brugerdata ligger i de relevante undertyper.&#xa;Valutaer og Karma Koins lægges aldrig sammen til én saldo." style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#172B4D;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="80" y="575" width="765" height="217" as="geometry"/>
                </mxCell>
                <mxCell id="rect5046" value="" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;fillColor=#F4F7FC;strokeColor=#C6D3E4;" parent="1" vertex="1">
                    <mxGeometry x="1730" y="520" width="785" height="282" as="geometry"/>
                </mxCell>
                <mxCell id="text5047" value="Bogføringsregler" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#172B4D;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1750" y="535" width="745" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="text5048" value="TX_STATE = {DRAFT, POSTED, VOID}. DRAFT kan have 0..N entries.&#xa;POSTED kræver mindst 2 entries og sum(amount) = 0 pr. aktiv.&#xa;amount er forskellig fra 0 og følger aktivets antal decimaler.&#xa;Bogføring er atomisk; brugerkonti må ikke blive negative.&#xa;POSTED-transaktioner og deres entries ændres eller slettes ikke.&#xa;Fejl korrigeres med en ny transaktion med modsat bevægelse.&#xa;reversal_of_id peger på den oprindelige POSTED-transaktion.&#xa;Korrektionen skal følge dens konti, aktiver og oprindelige beløb.&#xa;En unik idempotency_key forhindrer gentagelse af samme kald." style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#172B4D;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="1750" y="575" width="745" height="217" as="geometry"/>
                </mxCell>
                <mxCell id="rect5049" value="" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;fillColor=#F4F7FC;strokeColor=#C6D3E4;" parent="1" vertex="1">
                    <mxGeometry x="60" y="875" width="805" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="text5050" value="Opgaver og indløsninger i samme ledger" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#172B4D;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="890" width="765" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="text5051" value="TX_KIND = {TASK_PAYOUT, REWARD_REDEMPTION, REFUND, ADJUSTMENT}.&#xa;TASK_PAYOUT kræver task_participant_id; betalingen vedrører&#xa;den konkrete deltagers task. IndividualUser → IndividualUser: valuta.&#xa;OrganizationTask.reward_points er Karma Koins til IndividualUser.&#xa;REWARD_REDEMPTION kræver redemption_id og føres i KARMA.&#xa;Der angives højst én af de to forretningsreferencer pr. transaktion.&#xa;REFUND refererer til originalen via reversal_of_id.&#xa;PaidTask bruger currency-feltet; partnerafregning skal stadig aftales.&#xa;Ved TASK_PAYOUT er Task.created_by betaleren, og&#xa;TaskParticipant.user_id er modtageren i rollen CONTRIBUTOR." style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#172B4D;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="80" y="930" width="765" height="265" as="geometry"/>
                </mxCell>
                <mxCell id="rect5052" value="" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;fillColor=#F4F7FC;strokeColor=#C6D3E4;" parent="1" vertex="1">
                    <mxGeometry x="1730" y="875" width="785" height="281" as="geometry"/>
                </mxCell>
                <mxCell id="text5053" value="Eksempel · Reward til 100 Karma Koins" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#172B4D;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1750" y="890" width="745" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="text5054" value="RewardRedemption: quantity = 1; unit_karma_cost = 100.&#xa;Én POSTED-transaktion peger på denne indløsning.&#xa;Entry 1: IndividualUser-konto, KARMA, amount = -100.&#xa;Entry 2: systemets indløsningskonto, KARMA, amount = +100.&#xa;Sum for KARMA = 0. Brugeren har brugt 100 Karma Koins.&#xa;Systemkontoen er et eksempel på modkonto; partnerafregning er åben.&#xa;En tilbageførsel registreres som en ny transaktion: +100 / -100.&#xa;Reward er et tilbud, ikke et aktiv; indløsningen forbinder historikken." style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#172B4D;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="1750" y="930" width="745" height="216" as="geometry"/>
                </mxCell>
                <mxCell id="rect5055" value="" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;fillColor=#F4F7FC;strokeColor=#C6D3E4;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1780" width="805" height="238" as="geometry"/>
                </mxCell>
                <mxCell id="text5056" value="R18–R24 · kardinalitet" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#172B4D;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="1795" width="765" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="text5057" value="R18  Indløsning: 0..N transaktioner; transaktion: 0..1 indløsning.&#xa;R19  User: 0..N konti; konto: 0..1 ejer (SYSTEM har ingen).&#xa;R20  Asset: 0..N konti; konto: præcis ét aktiv.&#xa;R21  Konto: 0..N entries; entry: præcis én konto.&#xa;R22  Transaktion: 0..N entries; entry: præcis én transaktion.&#xa;R23  Deltager: 0..N transaktioner; transaktion: 0..1 deltager.&#xa;R24  Original: 0..N korrektioner; korrektion: 0..1 original." style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#172B4D;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="80" y="1835" width="765" height="173" as="geometry"/>
                </mxCell>
                <mxCell id="rect5058" value="" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;fillColor=#F4F7FC;strokeColor=#C6D3E4;" parent="1" vertex="1">
                    <mxGeometry x="1730" y="1780" width="785" height="238" as="geometry"/>
                </mxCell>
                <mxCell id="text5059" value="FK-mål" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#172B4D;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1750" y="1795" width="745" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="text5060" value="LedgerAccount.owner_user_id → User.id&#xa;LedgerAccount.asset_code → Asset.code&#xa;LedgerEntry.account_id → LedgerAccount.id&#xa;LedgerEntry.transaction_id → LedgerTransaction.id&#xa;LedgerTransaction.task_participant_id → TaskParticipant.id&#xa;LedgerTransaction.redemption_id → RewardRedemption.id&#xa;LedgerTransaction.reversal_of_id → LedgerTransaction.id" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#172B4D;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="1750" y="1835" width="745" height="173" as="geometry"/>
                </mxCell>
                <mxCell id="rect5061" value="" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;fillColor=#F4F7FC;strokeColor=#C6D3E4;" parent="1" vertex="1">
                    <mxGeometry x="60" y="2070" width="2480" height="126" as="geometry"/>
                </mxCell>
                <mxCell id="text5062" value="Læseregler" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#172B4D;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="2085" width="2440" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="text5063" value="1 / N = maksimum ved modsatte entitet. Enkeltlinje = valgfri; dobbeltlinje = obligatorisk deltagelse.&#xa;PK = primærnøgle · FK = fremmednøgle · UQ = unik · ? = nullable. De gentagne User-, TaskParticipant- og RewardRedemption-bokse refererer til samme entiteter på tværs af faner." style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#172B4D;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="80" y="2125" width="2440" height="61" as="geometry"/>
                </mxCell>
                <mxCell id="text5064" value="Teknisk reference: https://docs.tigerbeetle.com/coding/data-modeling/ · Generisk relationsmodel; ingen bestemt database er valgt." style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#536781;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="60" y="2220" width="2450" height="40" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>