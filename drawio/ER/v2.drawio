                <mxCell id="text5024" value="1" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=19;fontColor=#172B4D;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1274" y="943" width="50" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="text5025" value="N" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=19;fontColor=#172B4D;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1645" y="943" width="50" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="rect5026" value="" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;fillColor=#F4F7FC;strokeColor=#C6D3E4;" parent="1" vertex="1">
                    <mxGeometry x="1520" y="240" width="600" height="251" as="geometry"/>
                </mxCell>
                <mxCell id="text5027" value="Pris og historik" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#172B4D;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1540" y="255" width="560" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="text5028" value="karma_cost angiver prisen for én belønning.&#xa;Ved indløsning kopieres prisen til unit_karma_cost.&#xa;quantity skal være mindst 1; priser må ikke være negative.&#xa;Karma-total = quantity × unit_karma_cost.&#xa;Prisændringer på Reward ændrer ikke tidligere indløsninger.&#xa;Et Reward kan benyttes af mange IndividualUsers.&#xa;Kun aktive, ikke-udløbne Rewards kan indløses." style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#172B4D;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="1540" y="295" width="560" height="186" as="geometry"/>
                </mxCell>
                <mxCell id="rect5029" value="" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;fillColor=#F4F7FC;strokeColor=#C6D3E4;" parent="1" vertex="1">
                    <mxGeometry x="80" y="540" width="590" height="234" as="geometry"/>
                </mxCell>
                <mxCell id="text5030" value="Domæner og fælles entiteter" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#172B4D;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="100" y="555" width="550" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="text5031" value="REWARD_STATE = {DRAFT, ACTIVE, INACTIVE}&#xa;REDEEM_STATE = {PENDING, CONFIRMED, FULFILLED,&#xa;CANCELLED, REFUNDED}&#xa;RewardPartner og IndividualUser er undertyper af User.&#xa;De gentagne bokse på fanerne er de samme entiteter.&#xa;LedgerTransaction vises forkortet her; se “Ledger”." style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#172B4D;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="100" y="595" width="550" height="169" as="geometry"/>
                </mxCell>
                <mxCell id="rect5032" value="" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;fillColor=#F4F7FC;strokeColor=#C6D3E4;" parent="1" vertex="1">
                    <mxGeometry x="1450" y="540" width="670" height="305" as="geometry"/>
                </mxCell>
                <mxCell id="text5033" value="Fra indløsning til postering" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#172B4D;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1470" y="555" width="630" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="text5034" value="En indløsning har 0..N ledger-transaktioner: fx betaling&#xa;og en senere tilbageførsel. Hver transaktion refererer&#xa;til højst én indløsning; derfor er redemption_id nullable.&#xa;CONFIRMED kræver bogført betaling, hvis totalen er &gt; 0.&#xa;Betaling og bekræftelse gennemføres samlet og kun én gang.&#xa;En belønning til 0 Koins kræver ingen nulpostering.&#xa;Højst én POSTED REWARD_REDEMPTION pr. indløsning.&#xa;Brugerens KARMA-konto debiteres med den gemte Karma-total.&#xa;Partnerafregning er endnu ikke fastlagt." style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#172B4D;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="1470" y="595" width="630" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="rect5035" value="" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;fillColor=#F4F7FC;strokeColor=#C6D3E4;" parent="1" vertex="1">
                    <mxGeometry x="80" y="1230" width="2040" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="text5036" value="FK-mål og kardinaliteter" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#172B4D;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="100" y="1245" width="2000" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="text5037" value="R14  RewardPartner.user_id → User.id                         User 1 → 0..1 RewardPartner&#xa;R15  Reward.partner_user_id → RewardPartner.user_id        RewardPartner 1 → 0..N Reward&#xa;R16  RewardRedemption.reward_id → Reward.id                 Reward 1 → 0..N RewardRedemption&#xa;R17  RewardRedemption.individual_user_id → IndividualUser.user_id     IndividualUser 1 → 0..N RewardRedemption&#xa;R18  LedgerTransaction.redemption_id → RewardRedemption.id           Indløsning: 0..N transaktioner; transaktion: 0..1 indløsning" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#172B4D;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="100" y="1285" width="2000" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="rect5038" value="" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;fillColor=#F4F7FC;strokeColor=#C6D3E4;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1470" width="2080" height="126" as="geometry"/>
                </mxCell>
                <mxCell id="text5039" value="Læseregler" style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#172B4D;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="1485" width="2040" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="text5040" value="1 / N = maksimum ved modsatte entitet. Enkeltlinje = valgfri; dobbeltlinje = obligatorisk deltagelse.&#xa;PK = primærnøgle · FK = fremmednøgle · UQ = unik · ? = nullable. Alle relationer er redigerbare i draw.io." style="html=0;fontFamily=Arial;fontColor=#172B4D;fontSize=16;whiteSpace=wrap;shape=rect;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#172B4D;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="80" y="1525" width="2040" height="61" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
